server {
    listen 80;
    server_name _;

    # 静态资源根目录
    root /usr/share/nginx/html;
    index index.html;

    # 前端单页应用
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 反向代理到后端
    # /api/ask/stream  ->  ${BACKEND_URL}/ask/stream
    # /api/health      ->  ${BACKEND_URL}/health
    location /api/ {
        # 去掉 /api 前缀: /api/ask/stream -> /ask/stream
        rewrite ^/api/(.*)$ /$1 break;

        # 后端地址通过环境变量 BACKEND_URL 注入（nginx 启动时 envsubst 替换）
        # 直接用 proxy_pass（启动时解析，查 /etc/hosts + DNS，兼容 host.docker.internal 和容器名）
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Connection "";

        # ====== SSE 流式输出关键配置 ======
        proxy_buffering off;        # 禁用缓冲，确保实时输出
        proxy_cache off;            # 禁用缓存
        chunked_transfer_encoding on;

        # RAG 生成可能较慢，延长超时
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
